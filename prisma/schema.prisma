model BillingInvoice {
  id                     String                @id @default(uuid()) @db.Uuid
  billingAccountId       String                @map("billing_account_id") @db.Uuid
  planVersionId          String                @map("plan_version_id") @db.Uuid
  periodStart            DateTime              @map("period_start") @db.Timestamptz()
  periodEnd              DateTime              @map("period_end") @db.Timestamptz()
  // usage_period: monthly usage/renewal invoice (at most one per account+period).
  // plan_charge: independent upgrade proration charge (may coexist same month).
  purpose                BillingInvoicePurpose @default(usage_period) @map("purpose")
  status                 BillingInvoiceStatus  @default(open) @map("status")
  currency               String                @default("USD") @map("currency") @db.VarChar(10)
  grossOutboundMicros    BigInt                @default(0) @map("gross_outbound_micros")
  includedOutboundMicros BigInt?               @map("included_outbound_micros")
  billableOutboundMicros BigInt                @default(0) @map("billable_outbound_micros")
  apiCalls               BigInt                @default(0) @map("api_calls")
  includedApiCalls       BigInt?               @map("included_api_calls")
  activeWallets          Int                   @default(0) @map("active_wallets")
  includedWallets        Int?                  @map("included_wallets")
  monthlyFeeMicros       BigInt                @default(0) @map("monthly_fee_micros")
  outboundOverageMicros  BigInt                @default(0) @map("outbound_overage_micros")
  apiOverageMicros       BigInt                @default(0) @map("api_overage_micros")
  walletOverageMicros    BigInt                @default(0) @map("wallet_overage_micros")
  totalMicros            BigInt                @default(0) @map("total_micros")
  snapshotJson           Json                  @map("snapshot_json")
  snapshotHash           String                @map("snapshot_hash") @db.VarChar(64)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz()
  finalizedAt            DateTime?             @map("finalized_at") @db.Timestamptz()
  paidAt                 DateTime?             @map("paid_at") @db.Timestamptz()
  paidVia                BillingPaymentMethod? @map("paid_via")
  settlementAttemptId    String?               @unique @map("settlement_attempt_id") @db.Uuid
  // Cumulative confirmed coverage already allocated to this invoice from one
  // or more succeeded payment attempts (fixed-fee renewal + overage + full
  // rails). The invoice is only marked paid when allocatedMicros reaches
  // totalMicros; it is the single local accounting fact that prevents a fixed
  // recurring charge from falsely paying a dynamic (overage) invoice while
  // still allowing the overage remainder to be collected automatically.
  allocatedMicros        BigInt                @default(0) @map("allocated_micros")
  // Stripe invoice id for subscription-renewal invoices (unique so a renewal
  // invoice is materialized exactly once per Stripe invoice).
  stripeInvoiceId        String?               @unique @map("stripe_invoice_id") @db.VarChar(255)

  billingAccount    BillingAccount          @relation(fields: [billingAccountId], references: [id])
  planVersion       BillingPlanVersion      @relation(fields: [planVersionId], references: [id])
  lines             BillingInvoiceLine[]
  paymentAttempts   BillingPaymentAttempt[]
  settlementAttempt BillingPaymentAttempt?  @relation("InvoiceSettlement", fields: [settlementAttemptId], references: [id], onDelete: SetNull)
  // Reverse side of BillingPlanChange.chargeInvoiceId (1:1 when set).
  planChangeCharge  BillingPlanChange?      @relation("PlanChangeChargeInvoice")

  // usage_period uniqueness is enforced by a migration-only partial unique index
  // on (billing_account_id, period_start) WHERE purpose = 'usage_period'.
  // plan_charge rows may share the same period and are keyed via BillingPlanChange.
  @@index([billingAccountId, periodStart, periodEnd])
  @@index([billingAccountId, purpose, periodStart])
  @@map("billing_invoices")
}

