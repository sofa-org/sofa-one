  invoiceId        String  @map("invoice_id") @db.Uuid
  lineType         String  @map("line_type") @db.VarChar(40)
  description      String  @map("description") @db.VarChar(255)
  quantity         BigInt  @default(0) @map("quantity")
  unitRatePpm      Int?    @map("unit_rate_ppm")
  unitAmountMicros BigInt? @map("unit_amount_micros")
  amountMicros     BigInt  @map("amount_micros")
  metadata         Json?   @map("metadata")

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("billing_invoice_lines")
}

model BillingPaymentAttempt {
  id                           String                      @id @default(uuid()) @db.Uuid
  invoiceId                    String                      @map("invoice_id") @db.Uuid
  method                       BillingPaymentMethod        @default(stripe) @map("method")
  status                       BillingPaymentAttemptStatus @default(pending) @map("status")
  amountMicros                 BigInt                      @map("amount_micros")
  currency                     String                      @default("USD") @map("currency") @db.VarChar(10)
  stripeCheckoutSessionId      String?                     @unique @map("stripe_checkout_session_id") @db.VarChar(255)
  stripePaymentIntentId        String?                     @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  checkoutUrl                  String?                     @map("checkout_url") @db.VarChar(2048)
  // ── Stripe subscription renewal mapping (Phase 1 worker foundation). A
  //    renewal invoice is matched by stripeInvoiceId (unique); the
  //    subscription id and charge kind (fixed_fee vs full) record which rail
  //    produced the attempt so dynamic overage is never settled by a smaller
  //    fixed recurring charge.
  stripeInvoiceId              String?                     @unique @map("stripe_invoice_id") @db.VarChar(255)
  stripeSubscriptionId         String?                     @map("stripe_subscription_id") @db.VarChar(255)
  stripeChargeKind             String?                     @map("stripe_charge_kind") @db.VarChar(20)
  failureCode                  String?                     @map("failure_code") @db.VarChar(80)
  failureMessage               String?                     @map("failure_message") @db.VarChar(500)
  // ── USDC quote/evidence (Phase 3B foundation; nullable, only populated for
  //    method = usdc). Precise PostgreSQL types; no full sensitive payloads.
  chainId                      BigInt?                     @map("chain_id")
  tokenAddress                 String?                     @map("token_address") @db.VarChar(42)
  treasuryAddress              String?                     @map("treasury_address") @db.VarChar(42)
  tokenDecimals                Int?                        @map("token_decimals")
  expectedBaseUnits            BigInt?                     @map("expected_base_units")
  quoteExpiresAt               DateTime?                   @map("quote_expires_at") @db.Timestamptz()
  priceSource                  String?                     @map("price_source") @db.VarChar(40)
  // ── USDC quote snapshots (Phase 2; immutable, only populated for
  //    method = usdc). The claim path reads these, never the client, so a
  //    later wallet/chain/config change cannot alter an in-flight payment's
  //    expected payer or finality threshold.
  expectedPayerAddress         String?                     @map("expected_payer_address") @db.VarChar(42)
  requiredConfirmations        Int?                        @map("required_confirmations")
  // Non-secret digest derived from the per-chain RPC URL at quote time. The
  // raw URL (which may embed an API key) is never persisted, logged, or
  // returned; the claim path recomputes the digest from current config and
  // fails closed when the snapshot no longer matches the operational provider.
  providerIdentity             String?                     @map("provider_identity") @db.VarChar(64)
  txHash                       String?                     @map("tx_hash") @db.VarChar(66)
  logIndex                     Int?                        @map("log_index")
  payerAddress                 String?                     @map("payer_address") @db.VarChar(42)
  actualBaseUnits              BigInt?                     @map("actual_base_units")
  blockNumber                  BigInt?                     @map("block_number")
  blockHash                    String?                     @map("block_hash") @db.VarChar(66)
  blockTimestamp               BigInt?                     @map("block_timestamp")
  receiptEvidence              Json?                       @map("receipt_evidence")
  reviewReason                 String?                     @map("review_reason") @db.VarChar(255)
  lastCheckedAt                DateTime?                   @map("last_checked_at") @db.Timestamptz()
  checkoutRetryCount           Int                         @default(0) @map("checkout_retry_count")
  checkoutNextRetryAt          DateTime?                   @map("checkout_next_retry_at") @db.Timestamptz()
  checkoutRetryOwnerId         String?                     @map("checkout_retry_owner_id") @db.VarChar(80)
  checkoutRetryLeaseExpiresAt  DateTime?                   @map("checkout_retry_lease_expires_at") @db.Timestamptz()
  // ── BILL-014 post-paid sibling Checkout Session cleanup (durable lease).
  //    Triggered only after the invoice is fully paid. Expires open sibling
  //    Sessions outside DB locks; never refunds, cancels subscriptions, or
  //    mutates paid/settlement facts. Late duplicate payments remain
  //    duplicate_unallocated / needs_review.
  sessionCleanupStatus         String?                     @map("session_cleanup_status") @db.VarChar(20)
  sessionCleanupRetryCount     Int                         @default(0) @map("session_cleanup_retry_count")
  sessionCleanupNextRetryAt    DateTime?                   @map("session_cleanup_next_retry_at") @db.Timestamptz()
  sessionCleanupOwnerId        String?                     @map("session_cleanup_owner_id") @db.VarChar(80)
  sessionCleanupLeaseExpiresAt DateTime?                   @map("session_cleanup_lease_expires_at") @db.Timestamptz()
  sessionCleanupCompletedAt    DateTime?                   @map("session_cleanup_completed_at") @db.Timestamptz()
  // User-submitted USDC hash canonicalized and CAS-persisted BEFORE receipt
  // verification, so a worker/recovery path can resume a pending/confirming
  // claim across process restarts by reusing the existing verification path.
  submittedTxHash              String?                     @map("submitted_tx_hash") @db.VarChar(66)
  // Backoff schedule for the worker-driven USDC recovery (null for never).
  nextCheckAt                  DateTime?                   @map("next_check_at") @db.Timestamptz()
  createdAt                    DateTime                    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz()
  succeededAt                  DateTime?                   @map("succeeded_at") @db.Timestamptz()
  failedAt                     DateTime?                   @map("failed_at") @db.Timestamptz()
  // BILL-003: user-initiated cancel of a clean evidence-free pending USDC quote.
  // Distinct from failedAt/failureCode (provider/receipt failures) and from
  // reviewReason (needs_review evidence conflicts). Only set when status=cancelled.
  cancelledAt                  DateTime?                   @map("cancelled_at") @db.Timestamptz()
  cancelReason                 String?                     @map("cancel_reason") @db.VarChar(80)
  // Set exactly once when this attempt's coverage was counted toward the
  // invoice's allocatedMicros. A second allocation of the same attempt is an
  // idempotent no-op; it is also the durable marker the overage worker uses to
  // prove a fixed-fee renewal attempt has already been allocated.
  allocatedAt                  DateTime?                   @map("allocated_at") @db.Timestamptz()
  // ── Phase 2B wallet-payment reservation (dashboard pay-from-wallet).
  //    Binding to a billing_payment Transaction created under the acceptance
  //    lock before Openfort dispatch. Uniqueness of non-null FKs is a
  //    **migration-only partial unique index** (NULLs distinct) — not @unique,
  //    so Prisma does not invent a full-table unique that conflicts with
  //    multiple unbound rows. Reserved lookup index is also migration-only
  //    (WHERE wallet_payment_reserved = true).
  walletPaymentTransactionId   String?                     @map("wallet_payment_transaction_id") @db.Uuid
  walletPaymentReserved        Boolean                     @default(false) @map("wallet_payment_reserved")
  walletDispatchStartedAt      DateTime?                   @map("wallet_dispatch_started_at") @db.Timestamptz()

  invoice                  BillingInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  settledInvoice           BillingInvoice? @relation("InvoiceSettlement")
  // RESTRICT: deleting a bound billing_payment Transaction must not null the FK
  // while walletPaymentReserved remains true (B2). Unbind/release first if ever needed.
  walletPaymentTransaction Transaction?    @relation("WalletPaymentReservation", fields: [walletPaymentTransactionId], references: [id], onDelete: Restrict)

  // USDC Transfer evidence uniqueness: only populated for method='usdc' rows;
  // Postgres treats NULLs as distinct, so partial evidence never conflicts.
  @@unique([chainId, tokenAddress, txHash, logIndex])
  @@index([invoiceId, status])
  @@index([invoiceId, method, status])
  @@index([invoiceId, createdAt])
  @@index([submittedTxHash])
  // Non-partial helper index only; reserved-true partial index is migration-only.
  @@index([walletPaymentReserved])
  @@map("billing_payment_attempts")
}

model StripeWebhookEvent {
  id                  String                   @id @default(uuid()) @db.Uuid
  stripeEventId       String                   @unique @map("stripe_event_id") @db.VarChar(255)
  type                String                   @db.VarChar(120)
  status              StripeWebhookEventStatus @map("status")
  objectId            String?                  @map("object_id") @db.VarChar(255)
  receivedAt          DateTime                 @default(now()) @map("received_at") @db.Timestamptz()
  processedAt         DateTime?                @map("processed_at") @db.Timestamptz()
  // Deferred/unmatched renewal events are retried with bounded backoff by the
  // worker instead of being silently ignored. Only safe identifiers/error
  // codes are stored — never the full Stripe payload.
  retryCount          Int?                     @map("retry_count")
  nextRetryAt         DateTime?                @map("next_retry_at") @db.Timestamptz()
  errorType           String?                  @map("error_type") @db.VarChar(80)
  errorCode           String?                  @map("error_code") @db.VarChar(120)
  accountUserId       String?                  @map("account_user_id") @db.Uuid
  retryOwnerId        String?                  @map("retry_owner_id") @db.VarChar(120)
  retryLeaseExpiresAt DateTime?                @map("retry_lease_expires_at") @db.Timestamptz()

  @@index([type, receivedAt])
  @@index([status, nextRetryAt])
  @@map("stripe_webhook_events")
}

model BillingWorkerHeartbeat {
  workerId            String              @id @map("worker_id") @db.VarChar(80)
  status              BillingWorkerStatus @default(starting) @map("status")
  lastHeartbeatAt     DateTime            @default(now()) @map("last_heartbeat_at") @db.Timestamptz()
  lastStartedAt       DateTime?           @map("last_started_at") @db.Timestamptz()
  lastSuccessAt       DateTime?           @map("last_success_at") @db.Timestamptz()
  lastFailureAt       DateTime?           @map("last_failure_at") @db.Timestamptz()
  consecutiveFailures Int                 @default(0) @map("consecutive_failures")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("billing_worker_heartbeats")
}

/// Singleton keyset cursor for auto-subscription missing-intent recovery.
/// Advances past skipped/ineligible candidates so later eligible rows are not
/// starved across worker ticks.
model BillingAutoSubRecoveryCursor {
  id                String    @id @db.VarChar(40)
  cursorSucceededAt DateTime? @map("cursor_succeeded_at") @db.Timestamptz()
  cursorAttemptId   String?   @map("cursor_attempt_id") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("billing_auto_sub_recovery_cursors")
}
