generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  socialProvider String   @map("social_provider") @db.VarChar(20)
  socialId       String   @unique @map("social_id") @db.VarChar(255)
  email          String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  wallet       UserWallet?
  apiKeys      ApiKey[]
  transactions Transaction[]

  @@map("users")
}

model UserWallet {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  openfortAccountId String   @unique @map("openfort_account_id") @db.VarChar(255)
  walletAddress     String   @unique @map("wallet_address") @db.VarChar(42)
  chainId           BigInt   @map("chain_id")
  status            String   @default("active") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("user_wallets")
}

model ApiKey {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  apiKeyHash       String    @map("api_key_hash") @db.Text
  keyPrefix        String    @map("key_prefix") @db.VarChar(12)
  name             String?   @db.VarChar(100)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz()
  revoked          Boolean   @default(false)
  allowedIps       String[]  @map("allowed_ips")
  allowedContracts String[]  @map("allowed_contracts")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("api_keys")
}

model Transaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  intentId  String?  @map("intent_id") @db.VarChar(255)
  status    String   @db.VarChar(20)
  txHash    String?  @map("tx_hash") @db.VarChar(66)
  chainId   BigInt?  @map("chain_id")
  walletAddress String?  @map("wallet_address") @db.VarChar(42)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("transactions")
}
