generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BillingUsageMetric {
  outbound_volume
  api_call
}

enum BillingInvoiceStatus {
  open
  finalized
  needs_review
  void
}

enum BillingUsageEventStatus {
  unverified
  posted
  quarantined
  reversed
}

enum BillingUsageEntryType {
  usage
  reversal
  adjustment
}

enum BillingUsageSourceType {
  legacy_import
  api_request
  openfort_receipt
  reconciliation
  manual_adjustment
}

enum BillingPaymentMethod {
  stripe
  usdc
}

enum BillingPaymentAttemptStatus {
  pending
  confirming
  succeeded
  failed
  expired
  needs_review
  reorged
}

enum StripeWebhookEventStatus {
  processed
  ignored
  deferred
  needs_review
  failed
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  socialProvider String    @map("social_provider") @db.VarChar(20)
  socialId       String    @unique @map("social_id") @db.VarChar(255)
  email          String?   @db.VarChar(255)
  frozenAt       DateTime? @map("frozen_at") @db.Timestamptz()
  frozenReason   String?   @map("frozen_reason") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  wallet                UserWallet?
  withdrawalPolicy      WithdrawalPolicy?
  withdrawalAddresses   WithdrawalAddress[]
  apiKeys               ApiKey[]
  apiKeyEvents          ApiKeyEvent[]
  securityEvents        SecurityEvent[]
  securityNotifications SecurityNotification[]
  transactions          Transaction[]
  signingRequests       SigningRequest[]
  stepUpChallenges      StepUpChallenge[]
  mfaTotpCredential     UserMfaTotpCredential?
  knownIps              UserKnownIp[]
  billingAccount        BillingAccount?

  @@map("users")
}

model UserWallet {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  openfortAccountId      String?   @unique @map("openfort_account_id") @db.VarChar(255)
  walletAddress          String?   @unique @map("wallet_address") @db.VarChar(42)
  status                 String    @default("active") @db.VarChar(30)
  agentOpenfortAccountId String?   @unique @map("agent_openfort_account_id") @db.VarChar(255)
  agentWalletAddress     String?   @unique @map("agent_wallet_address") @db.VarChar(42)
  agentKeyHash           String?   @map("agent_key_hash") @db.VarChar(66)
  frozenAt               DateTime? @map("frozen_at") @db.Timestamptz()
  frozenReason           String?   @map("frozen_reason") @db.VarChar(255)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user                User                       @relation(fields: [userId], references: [id])
  chainAuthorizations WalletChainAuthorization[]
  securityEvents      SecurityEvent[]

  @@index([userId, frozenAt])
  @@map("user_wallets")
}

model WalletChainAuthorization {
  walletId           String    @map("wallet_id") @db.Uuid
  chainId            BigInt    @map("chain_id")
  status             String    @db.VarChar(30)
  registrationTxHash String?   @map("registration_tx_hash") @db.VarChar(66)
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  wallet UserWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@id([walletId, chainId])
  @@map("wallet_chain_authorizations")
}

model ApiKey {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  apiKeyHash               String    @map("api_key_hash") @db.Text
  keyPrefix                String    @map("key_prefix") @db.VarChar(32)
  name                     String?   @db.VarChar(100)
  expiresAt                DateTime? @map("expires_at") @db.Timestamptz()
  revoked                  Boolean   @default(false)
  frozenAt                 DateTime? @map("frozen_at") @db.Timestamptz()
  frozenReason             String?   @map("frozen_reason") @db.VarChar(255)
  canSign                  Boolean   @default(false) @map("can_sign")
  canSendTransaction       Boolean   @default(false) @map("can_send_transaction")
  canReadTransactionStatus Boolean   @default(true) @map("can_read_transaction_status")
  canUseEoaExecution       Boolean   @default(false) @map("can_use_eoa_execution")
  allowedIps               String[]  @map("allowed_ips")
  allowedContracts         String[]  @default([]) @map("allowed_contracts")
  allowedFunctionSelectors String[]  @default([]) @map("allowed_function_selectors")
  dailySpendLimit          String?   @map("daily_spend_limit") @db.VarChar(40)
  monthlySpendLimit        String?   @map("monthly_spend_limit") @db.VarChar(40)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastUsedAt               DateTime? @map("last_used_at") @db.Timestamptz()
  lastUsedIp               String?   @map("last_used_ip") @db.VarChar(64)
  lastUsedUserAgent        String?   @map("last_used_user_agent") @db.VarChar(255)

  user            User             @relation(fields: [userId], references: [id])
  signingRequests SigningRequest[]
  transactions    Transaction[]
  events          ApiKeyEvent[]
  securityEvents  SecurityEvent[]

  @@index([keyPrefix])
  @@index([userId, revoked])
  @@index([userId, frozenAt])
  @@index([userId])
  @@map("api_keys")
}

model ApiKeyEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  apiKeyId  String?  @map("api_key_id") @db.Uuid
  action    String   @db.VarChar(40)
  keyPrefix String?  @map("key_prefix") @db.VarChar(32)
  keyName   String?  @map("key_name") @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user   User    @relation(fields: [userId], references: [id])
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@map("api_key_events")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorType String   @map("actor_type") @db.VarChar(20)
  userId    String?  @map("user_id") @db.Uuid
  apiKeyId  String?  @map("api_key_id") @db.Uuid
  walletId  String?  @map("wallet_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(80)
  riskLevel String   @default("low") @map("risk_level") @db.VarChar(20)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  requestId String?  @map("request_id") @db.VarChar(64)
  result    String?  @db.VarChar(20)
  reason    String?  @db.VarChar(255)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey        ApiKey?                @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  wallet        UserWallet?            @relation(fields: [walletId], references: [id], onDelete: SetNull)
  notifications SecurityNotification[]

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([walletId, createdAt])
  @@index([eventType, createdAt])
  @@index([riskLevel, createdAt])
  @@map("security_events")
}

model SecurityNotification {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  securityEventId String?   @map("security_event_id") @db.Uuid
  type            String    @db.VarChar(80)
  title           String    @db.VarChar(120)
  body            String    @db.VarChar(500)
  riskLevel       String    @default("medium") @map("risk_level") @db.VarChar(20)
  readAt          DateTime? @map("read_at") @db.Timestamptz()
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityEvent SecurityEvent? @relation(fields: [securityEventId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([securityEventId])
  @@map("security_notifications")
}

model WithdrawalPolicy {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @unique @map("user_id") @db.Uuid
  singleWithdrawalLimit   String   @default("10000000000") @map("single_withdrawal_limit") @db.VarChar(40)
  dailyWithdrawalLimit    String?  @map("daily_withdrawal_limit") @db.VarChar(40)
  requireAddressAllowlist Boolean  @default(false) @map("require_address_allowlist")
  newAddressCooldownHours Int      @default(24) @map("new_address_cooldown_hours")
  requireStepUp           Boolean  @default(true) @map("require_step_up")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawal_policies")
}

model WithdrawalAddress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  address     String   @db.VarChar(42)
  label       String?  @db.VarChar(100)
  availableAt DateTime @map("available_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@index([userId, availableAt])
  @@map("withdrawal_addresses")
}

model Transaction {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  apiKeyId       String?   @map("api_key_id") @db.Uuid
  authMethod     String    @default("api_key") @map("auth_method") @db.VarChar(20)
  apiKeyPrefix   String?   @map("api_key_prefix") @db.VarChar(32)
  apiKeyName     String?   @map("api_key_name") @db.VarChar(100)
  status         String    @db.VarChar(20)
  txHash         String?   @map("tx_hash") @db.VarChar(66)
  chainId        BigInt    @map("chain_id")
  walletAddress  String    @map("wallet_address") @db.VarChar(42)
  operationType  String?   @map("operation_type") @db.VarChar(30)
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(64)
  requestHash    String?   @map("request_hash") @db.VarChar(64)
  failureReason  String?   @map("failure_reason") @db.VarChar(500)
  details        Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()
  // Set by reconciliation once a transaction's receipt has been processed
  // (confirmed, reverted, or quarantined). Confirmed rows without this marker
  // are re-scanned so a large confirmed historical backlog is drained in
  // bounded pages instead of keeping every run incomplete forever.
  billingReconciledAt DateTime? @map("billing_reconciled_at") @db.Timestamptz()
  billingPeriodStart  DateTime? @map("billing_period_start") @db.Timestamptz()
  billingLastAttemptedAt DateTime? @map("billing_last_attempted_at") @db.Timestamptz()
  userOpHash       String?   @unique @map("user_op_hash") @db.VarChar(66)
  userOpSuccess    Boolean?  @map("user_op_success")

  user               User                @relation(fields: [userId], references: [id])
  apiKey             ApiKey?             @relation(fields: [apiKeyId], references: [id])
  billingUsageEvents BillingUsageEvent[]

  @@unique([userId, operationType, chainId, idempotencyKey])
  @@index([apiKeyId, createdAt])
  @@index([requestHash])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, status, billingReconciledAt])
  @@index([userId, billingPeriodStart, billingReconciledAt, billingLastAttemptedAt])
  @@map("transactions")
}

model SigningRequest {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  apiKeyId      String?   @map("api_key_id") @db.Uuid
  authMethod    String    @default("api_key") @map("auth_method") @db.VarChar(20)
  apiKeyPrefix  String?   @map("api_key_prefix") @db.VarChar(32)
  apiKeyName    String?   @map("api_key_name") @db.VarChar(100)
  type          String    @db.VarChar(20)
  chainId       BigInt?   @map("chain_id")
  walletAddress String    @map("wallet_address") @db.VarChar(42)
  requestHash   String    @map("request_hash") @db.VarChar(64)
  digest        String    @db.VarChar(66)
  status        String    @default("submitting") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  completedAt   DateTime? @map("completed_at") @db.Timestamptz()

  user   User    @relation(fields: [userId], references: [id])
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([requestHash])
  @@map("signing_requests")
}

model UserKnownIp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  ip        String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ip])
  @@index([userId])
  @@map("user_known_ips")
}

model StepUpChallenge {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  type              String    @db.VarChar(20)
  challengeCodeHash String    @map("challenge_code_hash") @db.Text
  proofToken        String?   @map("proof_token") @db.VarChar(64)
  verified          Boolean   @default(false)
  attempts          Int       @default(0)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz()
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([proofToken])
  @@index([userId, createdAt])
  @@map("step_up_challenges")
}

model UserMfaTotpCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  encryptedSecret String    @map("encrypted_secret") @db.Text
  status          String    @default("pending") @db.VarChar(20)
  enabledAt       DateTime? @map("enabled_at") @db.Timestamptz()
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes UserMfaTotpRecoveryCode[]

  @@map("user_mfa_totp_credentials")
}

model UserMfaTotpRecoveryCode {
  id           String    @id @default(uuid()) @db.Uuid
  credentialId String    @map("credential_id") @db.Uuid
  codeHash     String    @map("code_hash") @db.Text
  usedAt       DateTime? @map("used_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  credential UserMfaTotpCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, usedAt])
  @@map("user_mfa_totp_recovery_codes")
}

model BillingAccount {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  stripeCustomerId String?  @unique @map("stripe_customer_id") @db.VarChar(255)
  // Stripe subscription mirror (one active subscription per account). Nullable
  // so legacy/one-time-checkout accounts remain valid; only populated by the
  // explicit subscription checkout path.
  stripeSubscriptionId           String?  @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripeSubscriptionStatus       String?  @map("stripe_subscription_status") @db.VarChar(40)
  stripeSubscriptionPeriodStart  DateTime? @map("stripe_subscription_period_start") @db.Timestamptz()
  // Renewal period end + the last subscription event's `created` timestamp
  // (unix seconds) so subscription bookkeeping is forward/event-order safe even
  // when renewal events arrive out of order. Nullable for legacy accounts.
  stripeSubscriptionPeriodEnd  DateTime? @map("stripe_subscription_period_end") @db.Timestamptz()
  stripeSubscriptionUpdatedAt  DateTime? @map("stripe_subscription_updated_at") @db.Timestamptz()
  // Tie equal-second Stripe events to a deterministic total order.
  stripeSubscriptionEventId String? @map("stripe_subscription_event_id") @db.VarChar(255)
  activeSubscriptionPlanVersionId String? @map("active_subscription_plan_version_id") @db.Uuid
  currency         String   @default("USD") @map("currency") @db.VarChar(10)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user        User                    @relation(fields: [userId], references: [id])
  assignments BillingPlanAssignment[]
  usageEvents BillingUsageEvent[]
  invoices    BillingInvoice[]

  @@map("billing_accounts")
}

model BillingPlanVersion {
  id                      String   @id @default(uuid()) @db.Uuid
  code                    String   @map("code") @db.VarChar(80)
  version                 Int      @map("version")
  name                    String   @map("name") @db.VarChar(120)
  description             String?  @map("description") @db.VarChar(255)
  monthlyFeeMicros        BigInt?  @map("monthly_fee_micros")
  includedOutboundMicros  BigInt?  @map("included_outbound_micros")
  includedApiCalls        BigInt?  @map("included_api_calls")
  includedWallets         Int?     @map("included_wallets")
  includedTeamMembers     Int?     @map("included_team_members")
  apiOverageRateMicros    BigInt   @default(0) @map("api_overage_rate_micros")
  walletOverageRateMicros BigInt   @default(0) @map("wallet_overage_rate_micros")
  effectiveFrom           DateTime @map("effective_from") @db.Timestamptz()
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tiers              BillingPlanTier[]
  assignments        BillingPlanAssignment[]
  invoices           BillingInvoice[]
  billingUsageEvents BillingUsageEvent[]

  @@unique([code, version])
  @@map("billing_plan_versions")
}

model BillingPlanTier {
  id               String  @id @default(uuid()) @db.Uuid
  planVersionId    String  @map("plan_version_id") @db.Uuid
  lowerBoundMicros BigInt  @map("lower_bound_micros")
  upperBoundMicros BigInt? @map("upper_bound_micros")
  ratePpm          Int     @map("rate_ppm")

  plan BillingPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, lowerBoundMicros])
  @@map("billing_plan_tiers")
}

model BillingPlanAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  billingAccountId String   @map("billing_account_id") @db.Uuid
  planVersionId    String   @map("plan_version_id") @db.Uuid
  periodStart      DateTime @map("period_start") @db.Timestamptz()
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  billingAccount BillingAccount     @relation(fields: [billingAccountId], references: [id])
  planVersion    BillingPlanVersion @relation(fields: [planVersionId], references: [id])

  @@unique([billingAccountId, periodStart])
  @@index([planVersionId])
  @@index([billingAccountId, periodStart])
  @@map("billing_plan_assignments")
}

model BillingReconciliationRun {
  id           String    @id @default(uuid()) @db.Uuid
  status       String    @default("running") @map("status") @db.VarChar(20)
  runType      String    @map("run_type") @db.VarChar(40)
  periodStart  DateTime  @map("period_start") @db.Timestamptz()
  periodEnd    DateTime? @map("period_end") @db.Timestamptz()
  source       String?   @map("source") @db.VarChar(80)
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  completedAt  DateTime? @map("completed_at") @db.Timestamptz()
  summary      Json?     @map("summary")
  errorDetails String?   @map("error_details") @db.VarChar(500)
  // ── Cross-instance worker lease / account scope (Phase 1 worker foundation).
  // billingAccountId/accountUserId scope the run to a single account; the
  // lease (leaseExpiresAt + heartbeatAt + workerId) lets a stale `running` run
  // be taken over by another instance. NULL for legacy runs that predate this
  // column (never backfilled — unprovable scope is kept conservatively risky).
  billingAccountId String?   @map("billing_account_id") @db.Uuid
  accountUserId    String?   @map("account_user_id") @db.Uuid
  workerId         String?   @map("worker_id") @db.VarChar(80)
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz()
  heartbeatAt      DateTime? @map("heartbeat_at") @db.Timestamptz()

  usageEvents BillingUsageEvent[]

  @@index([status, startedAt])
  @@index([periodStart, periodEnd])
  @@index([status, leaseExpiresAt])
  @@index([billingAccountId, periodStart])
  @@index([billingAccountId, periodStart, runType, status], map: "billing_reconciliation_runs_account_period_runtype_status_idx")
  @@map("billing_reconciliation_runs")
}

model BillingUsageEvent {
  id                    String                  @id @default(uuid()) @db.Uuid
  billingAccountId      String                  @map("billing_account_id") @db.Uuid
  metric                BillingUsageMetric      @map("metric")
  entryType             BillingUsageEntryType   @default(usage) @map("entry_type")
  sourceType            BillingUsageSourceType  @default(api_request) @map("source_type")
  status                BillingUsageEventStatus @default(unverified) @map("status")
  sourceKey             String                  @unique @map("source_key") @db.VarChar(255)
  periodStart           DateTime                @map("period_start") @db.Timestamptz()
  occurredAt            DateTime                @map("occurred_at") @db.Timestamptz()
  quantity              BigInt                  @default(1) @map("quantity")
  volumeUsdMicros       BigInt                  @default(0) @map("volume_usd_micros")
  baseUnitAmount        BigInt?                 @map("base_unit_amount")
  assetId               String?                 @map("asset_id") @db.VarChar(255)
  assetDecimals         Int?                    @map("asset_decimals")
  unitPriceMicros       BigInt?                 @map("unit_price_micros")
  priceSource           String?                 @map("price_source") @db.VarChar(40)
  chainId               BigInt?                 @map("chain_id")
  walletAddress         String?                 @map("wallet_address") @db.VarChar(42)
  txHash                String?                 @map("tx_hash") @db.VarChar(66)
  receiptRef            String?                 @map("receipt_ref") @db.VarChar(255)
  receiptLogIndex       Int?                    @map("receipt_log_index")
  receiptBlockNumber    BigInt?                 @map("receipt_block_number")
  receiptBlockHash      String?                 @map("receipt_block_hash") @db.VarChar(66)
  receiptBlockTimestamp BigInt?                 @map("receipt_block_timestamp")
  receiptStatus         String?                 @map("receipt_status") @db.VarChar(20)
  receiptData           Json?                   @map("receipt_data")
  planVersionId         String?                 @map("plan_version_id") @db.Uuid
  reconciliationRunId   String?                 @map("reconciliation_run_id") @db.Uuid
  reconciledAt          DateTime?               @map("reconciled_at") @db.Timestamptz()
  transactionId         String?                 @map("transaction_id") @db.Uuid
  requestId             String?                 @map("request_id") @db.VarChar(64)
  endpoint              String?                 @map("endpoint") @db.VarChar(120)
  statusCode            Int?                    @map("status_code")
  reversalOfId          String?                 @map("reversal_of_id") @db.Uuid
  adjustmentOfId        String?                 @map("adjustment_of_id") @db.Uuid
  metadata              Json?                   @map("metadata")

  billingAccount    BillingAccount            @relation(fields: [billingAccountId], references: [id])
  transaction       Transaction?              @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  planVersion       BillingPlanVersion?       @relation(fields: [planVersionId], references: [id], onDelete: SetNull)
  reconciliationRun BillingReconciliationRun? @relation(fields: [reconciliationRunId], references: [id], onDelete: SetNull)
  reversalOf        BillingUsageEvent?        @relation("UsageEventReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  adjustmentOf      BillingUsageEvent?        @relation("UsageEventAdjustment", fields: [adjustmentOfId], references: [id], onDelete: SetNull)
  reversals         BillingUsageEvent[]       @relation("UsageEventReversal")
  adjustments       BillingUsageEvent[]       @relation("UsageEventAdjustment")

  @@index([billingAccountId, periodStart, metric])
  @@index([billingAccountId, status, periodStart])
  @@index([billingAccountId, receiptRef])
  @@index([reconciliationRunId])
  @@index([reversalOfId])
  @@index([adjustmentOfId])
  @@index([transactionId])
  @@index([planVersionId])
  @@map("billing_usage_events")
}

model BillingInvoice {
  id                     String               @id @default(uuid()) @db.Uuid
  billingAccountId       String               @map("billing_account_id") @db.Uuid
  planVersionId          String               @map("plan_version_id") @db.Uuid
  periodStart            DateTime             @map("period_start") @db.Timestamptz()
  periodEnd              DateTime             @map("period_end") @db.Timestamptz()
  status                 BillingInvoiceStatus @default(open) @map("status")
  currency               String               @default("USD") @map("currency") @db.VarChar(10)
  grossOutboundMicros    BigInt               @default(0) @map("gross_outbound_micros")
  includedOutboundMicros BigInt?              @map("included_outbound_micros")
  billableOutboundMicros BigInt               @default(0) @map("billable_outbound_micros")
  apiCalls               BigInt               @default(0) @map("api_calls")
  includedApiCalls       BigInt?              @map("included_api_calls")
  activeWallets          Int                  @default(0) @map("active_wallets")
  includedWallets        Int?                 @map("included_wallets")
  monthlyFeeMicros       BigInt               @default(0) @map("monthly_fee_micros")
  outboundOverageMicros  BigInt               @default(0) @map("outbound_overage_micros")
  apiOverageMicros       BigInt               @default(0) @map("api_overage_micros")
  walletOverageMicros    BigInt               @default(0) @map("wallet_overage_micros")
  totalMicros            BigInt               @default(0) @map("total_micros")
  snapshotJson           Json                 @map("snapshot_json")
  snapshotHash           String               @map("snapshot_hash") @db.VarChar(64)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  finalizedAt            DateTime?            @map("finalized_at") @db.Timestamptz()
  paidAt                 DateTime?            @map("paid_at") @db.Timestamptz()
  paidVia                BillingPaymentMethod? @map("paid_via")
  settlementAttemptId    String?              @unique @map("settlement_attempt_id") @db.Uuid
  // Stripe invoice id for subscription-renewal invoices (unique so a renewal
  // invoice is materialized exactly once per Stripe invoice).
  stripeInvoiceId        String?              @unique @map("stripe_invoice_id") @db.VarChar(255)

  billingAccount   BillingAccount       @relation(fields: [billingAccountId], references: [id])
  planVersion      BillingPlanVersion   @relation(fields: [planVersionId], references: [id])
  lines            BillingInvoiceLine[]
  paymentAttempts  BillingPaymentAttempt[]
  settlementAttempt BillingPaymentAttempt? @relation("InvoiceSettlement", fields: [settlementAttemptId], references: [id], onDelete: SetNull)

  @@unique([billingAccountId, periodStart])
  @@index([billingAccountId, periodStart, periodEnd])
  @@map("billing_invoices")
}

model BillingInvoiceLine {
  id               String  @id @default(uuid()) @db.Uuid
  invoiceId        String  @map("invoice_id") @db.Uuid
  lineType         String  @map("line_type") @db.VarChar(40)
  description      String  @map("description") @db.VarChar(255)
  quantity         BigInt  @default(0) @map("quantity")
  unitRatePpm      Int?    @map("unit_rate_ppm")
  unitAmountMicros BigInt? @map("unit_amount_micros")
  amountMicros     BigInt  @map("amount_micros")
  metadata         Json?   @map("metadata")

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("billing_invoice_lines")
}

model BillingPaymentAttempt {
  id                      String                     @id @default(uuid()) @db.Uuid
  invoiceId               String                     @map("invoice_id") @db.Uuid
  method                  BillingPaymentMethod       @default(stripe) @map("method")
  status                  BillingPaymentAttemptStatus @default(pending) @map("status")
  amountMicros            BigInt                     @map("amount_micros")
  currency                String                     @default("USD") @map("currency") @db.VarChar(10)
  stripeCheckoutSessionId String?                    @unique @map("stripe_checkout_session_id") @db.VarChar(255)
  stripePaymentIntentId   String?                    @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  checkoutUrl             String?                    @map("checkout_url") @db.VarChar(2048)
  // ── Stripe subscription renewal mapping (Phase 1 worker foundation). A
  //    renewal invoice is matched by stripeInvoiceId (unique); the
  //    subscription id and charge kind (fixed_fee vs full) record which rail
  //    produced the attempt so dynamic overage is never settled by a smaller
  //    fixed recurring charge.
  stripeInvoiceId         String?                    @unique @map("stripe_invoice_id") @db.VarChar(255)
  stripeSubscriptionId    String?                    @map("stripe_subscription_id") @db.VarChar(255)
  stripeChargeKind        String?                    @map("stripe_charge_kind") @db.VarChar(20)
  failureCode             String?                    @map("failure_code") @db.VarChar(80)
  failureMessage          String?                    @map("failure_message") @db.VarChar(500)
  // ── USDC quote/evidence (Phase 3B foundation; nullable, only populated for
  //    method = usdc). Precise PostgreSQL types; no full sensitive payloads.
  chainId                 BigInt?                    @map("chain_id")
  tokenAddress            String?                    @map("token_address") @db.VarChar(42)
  treasuryAddress         String?                    @map("treasury_address") @db.VarChar(42)
  tokenDecimals           Int?                       @map("token_decimals")
  expectedBaseUnits       BigInt?                    @map("expected_base_units")
  quoteExpiresAt          DateTime?                  @map("quote_expires_at") @db.Timestamptz()
  priceSource             String?                    @map("price_source") @db.VarChar(40)
  // ── USDC quote snapshots (Phase 2; immutable, only populated for
  //    method = usdc). The claim path reads these, never the client, so a
  //    later wallet/chain/config change cannot alter an in-flight payment's
  //    expected payer or finality threshold.
  expectedPayerAddress    String?                    @map("expected_payer_address") @db.VarChar(42)
  requiredConfirmations   Int?                       @map("required_confirmations")
  // Non-secret digest derived from the per-chain RPC URL at quote time. The
  // raw URL (which may embed an API key) is never persisted, logged, or
  // returned; the claim path recomputes the digest from current config and
  // fails closed when the snapshot no longer matches the operational provider.
  providerIdentity        String?                    @map("provider_identity") @db.VarChar(64)
  txHash                  String?                    @map("tx_hash") @db.VarChar(66)
  logIndex                Int?                       @map("log_index")
  payerAddress            String?                    @map("payer_address") @db.VarChar(42)
  actualBaseUnits         BigInt?                    @map("actual_base_units")
  blockNumber             BigInt?                    @map("block_number")
  blockHash               String?                    @map("block_hash") @db.VarChar(66)
  blockTimestamp          BigInt?                    @map("block_timestamp")
  receiptEvidence         Json?                      @map("receipt_evidence")
  reviewReason            String?                    @map("review_reason") @db.VarChar(255)
  lastCheckedAt           DateTime?                  @map("last_checked_at") @db.Timestamptz()
  checkoutRetryCount      Int                        @default(0) @map("checkout_retry_count")
  checkoutNextRetryAt     DateTime?                  @map("checkout_next_retry_at") @db.Timestamptz()
  checkoutRetryOwnerId    String?                    @map("checkout_retry_owner_id") @db.VarChar(80)
  checkoutRetryLeaseExpiresAt DateTime?              @map("checkout_retry_lease_expires_at") @db.Timestamptz()
  // User-submitted USDC hash canonicalized and CAS-persisted BEFORE receipt
  // verification, so a worker/recovery path can resume a pending/confirming
  // claim across process restarts by reusing the existing verification path.
  submittedTxHash         String?                    @map("submitted_tx_hash") @db.VarChar(66)
  // Backoff schedule for the worker-driven USDC recovery (null for never).
  nextCheckAt             DateTime?                  @map("next_check_at") @db.Timestamptz()
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz()
  succeededAt             DateTime?                  @map("succeeded_at") @db.Timestamptz()
  failedAt                DateTime?                  @map("failed_at") @db.Timestamptz()

  invoice        BillingInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  settledInvoice BillingInvoice? @relation("InvoiceSettlement")

  // USDC Transfer evidence uniqueness: only populated for method='usdc' rows;
  // Postgres treats NULLs as distinct, so partial evidence never conflicts.
  @@unique([chainId, tokenAddress, txHash, logIndex])
  @@index([invoiceId, status])
  @@index([invoiceId, method, status])
  @@index([invoiceId, createdAt])
  @@index([submittedTxHash])
  @@map("billing_payment_attempts")
}

model StripeWebhookEvent {
  id            String                  @id @default(uuid()) @db.Uuid
  stripeEventId String                  @unique @map("stripe_event_id") @db.VarChar(255)
  type          String                  @db.VarChar(120)
  status        StripeWebhookEventStatus @map("status")
  objectId      String?                 @map("object_id") @db.VarChar(255)
  receivedAt    DateTime                @default(now()) @map("received_at") @db.Timestamptz()
  processedAt   DateTime?               @map("processed_at") @db.Timestamptz()
  // Deferred/unmatched renewal events are retried with bounded backoff by the
  // worker instead of being silently ignored. Only safe identifiers/error
  // codes are stored — never the full Stripe payload.
  retryCount    Int?                    @map("retry_count")
  nextRetryAt   DateTime?               @map("next_retry_at") @db.Timestamptz()
  errorType     String?                 @map("error_type") @db.VarChar(80)
  errorCode     String?                 @map("error_code") @db.VarChar(120)
  accountUserId String?                 @map("account_user_id") @db.Uuid
  retryOwnerId String?                  @map("retry_owner_id") @db.VarChar(120)
  retryLeaseExpiresAt DateTime?         @map("retry_lease_expires_at") @db.Timestamptz()

  @@index([type, receivedAt])
  @@index([status, nextRetryAt])
  @@map("stripe_webhook_events")
}
