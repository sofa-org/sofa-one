/// Durable Stripe subscription mirror sync intent (Gate 1 B4).
/// Local plan-change apply commits the intent in the same TX; Stripe is called
/// only AFTER commit. Local entitlement never depends on sync success.
model BillingSubscriptionSyncIntent {
  id                       String                        @id @default(uuid()) @db.Uuid
  billingAccountId         String                        @map("billing_account_id") @db.Uuid
  // Monotonic per-account revision. Older unresolved revisions dispatch first;
  // never-dispatched pending may be superseded by a newer enqueue.
  revision                 Int                           @map("revision")
  sourcePlanChangeId       String?                       @map("source_plan_change_id") @db.Uuid
  kind                     BillingSubscriptionSyncKind   @map("kind")
  status                   BillingSubscriptionSyncStatus @default(pending) @map("status")
  // Frozen binding at enqueue time (never client-supplied).
  stripeCustomerId         String                        @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId     String                        @map("stripe_subscription_id") @db.VarChar(255)
  // Filled after first successful retrieve of the licensed monthly item.
  stripeSubscriptionItemId String?                       @map("stripe_subscription_item_id") @db.VarChar(255)
  targetPlanVersionId      String?                       @map("target_plan_version_id") @db.Uuid
  // Positive fee in Stripe cents for update_item; null for cancel_at_period_end.
  targetUnitAmountCents    Int?                          @map("target_unit_amount_cents")
  targetCurrency           String                        @default("usd") @map("target_currency") @db.VarChar(10)
  // Provider validation window at enqueue (current subscription item period).
  expectedPeriodStart      DateTime?                     @map("expected_period_start") @db.Timestamptz()
  expectedPeriodEnd        DateTime?                     @map("expected_period_end") @db.Timestamptz()
  // Stable provider idempotency key for the exact same mutation payload.
  operationIdempotencyKey  String                        @unique @map("operation_idempotency_key") @db.VarChar(120)
  // Frozen provider mutation payload (item/product/cents/periods); immutable after first freeze.
  frozenPayloadJson        Json?                         @map("frozen_payload_json")
  // Set when the provider call is first attempted; marks uncertain until terminal.
  dispatchedAt             DateTime?                     @map("dispatched_at") @db.Timestamptz()
  retryCount               Int                           @default(0) @map("retry_count")
  nextRetryAt              DateTime?                     @map("next_retry_at") @db.Timestamptz()
  leaseOwnerId             String?                       @map("lease_owner_id") @db.VarChar(80)
  leaseExpiresAt           DateTime?                     @map("lease_expires_at") @db.Timestamptz()
  lastErrorCode            String?                       @map("last_error_code") @db.VarChar(80)
  lastErrorType            String?                       @map("last_error_type") @db.VarChar(80)
  // Frozen verified provider facts after sync (safe identifiers only).
  syncedProviderPriceId    String?                       @map("synced_provider_price_id") @db.VarChar(255)
  // First renewal month this config governs (UTC month from current period end).
  // Distinct from expected*: a Sep sync validates the current period but applies
  // from the following month forward until a higher-revision update/cancel.
  // effectivePeriodEnd is the exclusive end of that first month (informational);
  // renewal identity carries forward past it via revision ordering.
  effectivePeriodStart     DateTime?                     @map("effective_period_start") @db.Timestamptz()
  effectivePeriodEnd       DateTime?                     @map("effective_period_end") @db.Timestamptz()
  syncedAt                 DateTime?                     @map("synced_at") @db.Timestamptz()
  createdAt                DateTime                      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime                      @updatedAt @map("updated_at") @db.Timestamptz()

  billingAccount    BillingAccount      @relation(fields: [billingAccountId], references: [id])
  targetPlanVersion BillingPlanVersion? @relation(fields: [targetPlanVersionId], references: [id], onDelete: SetNull)

  @@unique([billingAccountId, revision])
  @@index([status, nextRetryAt])
  @@index([billingAccountId, status])
  @@index([stripeSubscriptionId])
  // Partial unique (one in_flight per account) lives in SQL migrations only:
  // 20260917150000_sync_intent_queue_behind_in_flight.
  @@map("billing_subscription_sync_intents")
}

/// Durable first-subscription create intent after a successful one-time Card
/// payment (plan_charge upgrade or fixed-fee usage_period first invoice).
/// Stripe Subscriptions.create runs outside DB transactions with a stable
/// operation idempotency key. Billing starts at the next UTC month — never a
/// historical invoice periodStart anchor.
model BillingAutoSubscriptionIntent {
  id                      String                        @id @default(uuid()) @db.Uuid
  billingAccountId        String                        @map("billing_account_id") @db.Uuid
  sourceInvoiceId         String                        @map("source_invoice_id") @db.Uuid
  sourceAttemptId         String                        @unique @map("source_attempt_id") @db.Uuid
  planVersionId           String                        @map("plan_version_id") @db.Uuid
  stripeCustomerId        String                        @map("stripe_customer_id") @db.VarChar(255)
  // Proven PaymentMethod id (from PaymentIntent after attach/default save).
  stripePaymentMethodId   String?                       @map("stripe_payment_method_id") @db.VarChar(255)
  // First subscription billing window: next UTC month after the paid invoice.
  effectivePeriodStart    DateTime                      @map("effective_period_start") @db.Timestamptz()
  effectivePeriodEnd      DateTime                      @map("effective_period_end") @db.Timestamptz()
  unitAmountCents         Int                           @map("unit_amount_cents")
  currency                String                        @default("usd") @map("currency") @db.VarChar(10)
  status                  BillingAutoSubscriptionStatus @default(pending) @map("status")
  // Stable provider idempotency key for the exact create payload (never rotates).
  operationIdempotencyKey String                        @unique @map("operation_idempotency_key") @db.VarChar(160)
  frozenPayloadJson       Json?                         @map("frozen_payload_json")
  stripeSubscriptionId    String?                       @map("stripe_subscription_id") @db.VarChar(255)
  dispatchedAt            DateTime?                     @map("dispatched_at") @db.Timestamptz()
  paymentMethodSavedAt    DateTime?                     @map("payment_method_saved_at") @db.Timestamptz()
  retryCount              Int                           @default(0) @map("retry_count")
  nextRetryAt             DateTime?                     @map("next_retry_at") @db.Timestamptz()
  leaseOwnerId            String?                       @map("lease_owner_id") @db.VarChar(80)
  leaseExpiresAt          DateTime?                     @map("lease_expires_at") @db.Timestamptz()
  lastErrorCode           String?                       @map("last_error_code") @db.VarChar(80)
  lastErrorType           String?                       @map("last_error_type") @db.VarChar(80)
  completedAt             DateTime?                     @map("completed_at") @db.Timestamptz()
  createdAt               DateTime                      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime                      @updatedAt @map("updated_at") @db.Timestamptz()

  billingAccount BillingAccount     @relation(fields: [billingAccountId], references: [id])
  planVersion    BillingPlanVersion @relation(fields: [planVersionId], references: [id])

  @@index([status, nextRetryAt])
  @@index([billingAccountId, status])
  @@index([sourceInvoiceId])
  // Partial unique (one unfinished per account) lives in SQL migrations only.
  @@map("billing_auto_subscription_intents")
}

model BillingReconciliationRun {
  id               String    @id @default(uuid()) @db.Uuid
  status           String    @default("running") @map("status") @db.VarChar(20)
  runType          String    @map("run_type") @db.VarChar(40)
  periodStart      DateTime  @map("period_start") @db.Timestamptz()
  periodEnd        DateTime? @map("period_end") @db.Timestamptz()
  source           String?   @map("source") @db.VarChar(80)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  completedAt      DateTime? @map("completed_at") @db.Timestamptz()
  summary          Json?     @map("summary")
  errorDetails     String?   @map("error_details") @db.VarChar(500)
  // ── Cross-instance worker lease / account scope (Phase 1 worker foundation).
  // billingAccountId/accountUserId scope the run to a single account; the
  // lease (leaseExpiresAt + heartbeatAt + workerId) lets a stale `running` run
  // be taken over by another instance. NULL for legacy runs that predate this
  // column (never backfilled — unprovable scope is kept conservatively risky).
  billingAccountId String?   @map("billing_account_id") @db.Uuid
  accountUserId    String?   @map("account_user_id") @db.Uuid
  workerId         String?   @map("worker_id") @db.VarChar(80)
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz()
  heartbeatAt      DateTime? @map("heartbeat_at") @db.Timestamptz()

  usageEvents BillingUsageEvent[]

  @@index([status, startedAt])
  @@index([periodStart, periodEnd])
  @@index([status, leaseExpiresAt])
  @@index([billingAccountId, periodStart])
  @@index([billingAccountId, periodStart, runType, status], map: "billing_reconciliation_runs_account_period_runtype_status_idx")
  @@map("billing_reconciliation_runs")
}

