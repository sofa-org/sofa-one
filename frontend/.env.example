# Openfort email OTP / embedded wallet / Shield
VITE_OPENFORT_PUBLISHABLE_KEY=pk_test_xxx
VITE_OPENFORT_SHIELD_PUBLISHABLE_KEY=pk_test_xxx
# Optional Openfort sponsorship policy for 7702 UserOperations.
# VITE_OPENFORT_FEE_SPONSORSHIP_ID=pol_xxx

# Backend API
VITE_API_URL=http://localhost:3100

# Optional browser-safe RPC overrides used by wagmi/viem.
# Leave unset to use public defaults configured in src/components/AuthProviders.tsx.
# VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# VITE_BASE_RPC_URL=https://mainnet.base.org
# VITE_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# VITE_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# VITE_POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
