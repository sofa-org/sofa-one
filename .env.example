# Openfort (Email OTP / Embedded Wallet / Backend Agent Wallet)
OPENFORT_API_KEY=sk_test_xxx
# Publishable key used as Bearer auth for Openfort RPC/bundler UserOperation submission.
OPENFORT_PUBLISHABLE_KEY=pk_test_xxx
# TEE wallet signing secret from the Openfort dashboard. Must have minimum permissions (wallet:sign only). NEVER log or expose this value.
OPENFORT_WALLET_SECRET=xxx
# 32 random bytes, base64 encoded. Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_SECRET_ENCRYPTION_KEY=
# Timeout for Openfort SDK calls. Sending operations are not retried automatically.
OPENFORT_TIMEOUT_MS=15000

# Pimlico RPC/bundler for Monad UserOperations (Openfort RPC does not support Monad).
PIMLICO_API_KEY=
# Optional overrides; defaults to https://api.pimlico.io/v2/{chainId}/rpc?apikey=$PIMLICO_API_KEY
# PIMLICO_RPC_URL_143=
# PIMLICO_RPC_URL_10143=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_wallet
# Used by docker-compose only (not the app directly). Must match the password in DATABASE_URL for local dev.
POSTGRES_PASSWORD=

# Redis (for BullMQ — Phase 2)
REDIS_URL=redis://localhost:6379
# Used by docker-compose only (not the app directly). Set a strong password in production.
REDIS_PASSWORD=

# Blockchain
# Supported: Base Sepolia (84532), Base (8453), Ethereum (1), Ethereum Sepolia (11155111), Polygon (137), Polygon Amoy (80002), Arbitrum One (42161), OP Mainnet (10), OP Sepolia (11155420), BNB Smart Chain (56), BNB Smart Chain Testnet (97), Monad (143), Monad Testnet (10143)
# Must be one of the supported chain IDs above; app startup fails otherwise.
# Defaults to Base Sepolia (84532) if unset.
DEFAULT_CHAIN_ID=84532

# App
PORT=3100
NODE_ENV=development
# Production only: explicit trusted reverse proxy IP/CIDR list, comma-separated.
# Leave empty in local development. Do not set to true/1.
TRUST_PROXY=

# CORS
# REQUIRED in production (NODE_ENV=production). Comma-separated list of exact allowed frontend origins.
# App refuses to start if empty in production. Leave empty in local development to use localhost defaults.
CORS_ORIGIN=

# Step-up OTP delivery
# REQUIRED in production. The backend POSTs step-up OTP payloads here:
# { type, userId, email, challengeId, code, expiresAt }
# The endpoint must deliver the code to the user's verified email address.
STEP_UP_OTP_WEBHOOK_URL=
# Optional bearer token sent as Authorization: Bearer <secret> to the webhook.
STEP_UP_OTP_WEBHOOK_SECRET=

# High-risk backend EOA execution
# Default is disabled. Set to "true" only when operationally required; EOA API keys still require
# short TTL, IP allowlist, independent rate limiting, and security-event audit.
EOA_EXECUTION_ENABLED=false

# Security event SIEM export (optional)
# When set, every persisted SecurityEvent is POSTed as a safe JSON payload to this HTTPS endpoint.
# Payload excludes raw API keys, secrets, full calldata, typed data, and authorization material.
SECURITY_EVENTS_SIEM_WEBHOOK_URL=
# Optional bearer token sent as Authorization: Bearer <secret> to the SIEM webhook.
SECURITY_EVENTS_SIEM_WEBHOOK_SECRET=

# Stripe (Commercial Billing Phase 3A — optional)
# Secret key for server-side Stripe API calls (customers, checkout sessions, payment intents).
# Leave empty when Stripe billing is not configured; the app and tests still start.
STRIPE_SECRET_KEY=
# Signing secret for verifying Stripe webhook signatures. Leave empty when webhooks are not configured.
STRIPE_WEBHOOK_SECRET=
# Server-side redirect URLs for Checkout (never accepted from the client).
# Required (https) when STRIPE_SECRET_KEY is set.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# USDC billing (Phase 3B foundation — optional)
# When enabled, USDC invoice payments are supported on Base (8453) and Base Sepolia (84532).
# Treasury addresses are static per-chain environment addresses; the app never holds their private keys.
# Leave disabled/empty when USDC billing is not configured; the app and tests still start.
BILLING_USDC_ENABLED=false
# Static per-chain treasury addresses (EVM format: 0x + 40 hex chars). Required when enabled.
BILLING_USDC_TREASURY_ADDRESS_8453=
BILLING_USDC_TREASURY_ADDRESS_84532=
# Per-chain RPC URLs for on-chain payment confirmation. Required when enabled.
BILLING_USDC_RPC_URL_8453=
BILLING_USDC_RPC_URL_84532=
# Number of confirmations before a USDC payment is settled (default 5).
BILLING_USDC_REQUIRED_CONFIRMATIONS=5
# Quote TTL in seconds (default 86400 = 24h).
BILLING_USDC_QUOTE_TTL_SECONDS=86400
