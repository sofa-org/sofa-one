# Clerk (Social OAuth)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Openfort (Wallet / TEE)
OPENFORT_API_KEY=sk_test_xxx
# TEE wallet signing secret from the Openfort dashboard. Must have minimum permissions (wallet:sign only). NEVER log or expose this value.
OPENFORT_WALLET_SECRET=xxx

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_wallet
# Used by docker-compose only (not the app directly). Must match the password in DATABASE_URL for local dev.
POSTGRES_PASSWORD=

# Redis (for BullMQ — Phase 2)
REDIS_URL=redis://localhost:6379
# Used by docker-compose only (not the app directly). Set a strong password in production.
REDIS_PASSWORD=

# Blockchain
DEFAULT_CHAIN_ID=84532

# App
PORT=3100
NODE_ENV=development

# CORS
# REQUIRED in production (NODE_ENV=production). Comma-separated list of allowed frontend origins. App refuses to start if empty in production.
CORS_ORIGIN=
