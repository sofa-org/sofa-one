# Clerk (Social OAuth)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Openfort (Wallet / TEE)
OPENFORT_API_KEY=sk_test_xxx
OPENFORT_WALLET_SECRET=xxx

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_wallet

# Redis (for BullMQ — Phase 2)
REDIS_URL=redis://localhost:6379

# Blockchain
DEFAULT_CHAIN_ID=84532

# App
PORT=3001
NODE_ENV=development

# Frontend (Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_API_URL=                          # Leave empty for dev (uses Vite proxy); set to full URL for prod (e.g., https://api.yourdomain.com)

# CORS
CORS_ORIGIN=                           # Comma-separated allowed origins (e.g., https://app.yourdomain.com); defaults to * if empty
