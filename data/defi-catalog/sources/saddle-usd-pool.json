      "signature": "removeLiquidity(uint256,uint256[],uint256)",
      "modifiers": [
        "nonReentrant",
        "deadlineCheck(deadline)"
      ],
      "noWhenNotPaused": true,
      "body": "return swapStorage.removeLiquidity(amount, minAmounts);",
      "evidence": "Source notice explicitly says liquidity can be removed even when the pool is paused. Linked SwapUtils checks LP balance and minAmounts length, computes fee-adjusted proportional shares using recorded balances and LP totalSupply, enforces each minimum, updates balances, transfers pooled tokens to msg.sender, then burns caller LP with burnFrom."
    },
    "pauseGatedUserFunctions": [
